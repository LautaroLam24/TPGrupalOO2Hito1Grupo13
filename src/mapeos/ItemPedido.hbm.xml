<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>

    <class name="datos.ItemPedido" table="item_pedido">

        <id name="id" column="id">
            <generator class="identity"/>
        </id>

        <property name="nombre"
                  column="nombre"
                  type="string"
                  not-null="true"/>

        <property name="cantidad"
                  column="cantidad"
                  type="integer"
                  not-null="true"/>

        <many-to-one
            name="pedido"
            class="datos.Pedido"
            column="pedido_id"
            not-null="true"/>

        <many-to-one
            name="plato"
            class="datos.Plato"
            column="plato_id"
            not-null="true"/>

    </class>

</hibernate-mapping>